# ── Postgres (Railway) ─────────────────────────────────────
# Pega aquí la "Postgres Connection URL" de Railway (variables del servicio).
# Ejemplo: postgresql://postgres:PASSWORD@HOST:5432/railway
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dolphin

# ── Storage S3 / R2 (fotos desde el día 1) ───────────────────
# AWS S3: S3_ENDPOINT vacío + S3_REGION (ej. us-east-1).
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# + S3_REGION=auto. Las keys son las del token API de R2 (S3-compatible).
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=dolphin-fotos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública base para servir fotos (dominio del bucket o Custom Domain de R2).
# Ejemplo: https://pub-xxxx.r2.dev o https://fotos.tudominio.com
S3_PUBLIC_URL=

# ── Sitio ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Analytics (se instrumenta en el Paso 9) ──────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
