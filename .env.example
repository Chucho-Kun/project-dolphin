# ── Postgres (Railway) ─────────────────────────────────────
# Pega aquí la "Postgres Connection URL" de Railway (variables del servicio).
# Ejemplo: postgresql://postgres:PASSWORD@HOST:5432/railway
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dolphin

# ── Storage Cloudflare R2 (fotos desde el día 1) ─────────────
# Endpoint S3-compatible derivado: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Región siempre "auto" en R2. Las keys son las del token API de R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dolphin-fotos
# URL pública base para servir fotos (Custom Domain de R2 o URL pub-*.r2.dev).
# Ejemplo: https://fotos.tudominio.com o https://pub-xxxx.r2.dev
NEXT_PUBLIC_CDN_URL=

# ── Sitio ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Analytics (se instrumenta en el Paso 9) ──────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
